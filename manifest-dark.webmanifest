{
  "name": "McFamily",
  "short_name": "McFamily",
  "description": "A private, local-first family tree, address book, and printable family atlas.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
