{
  "name": "App Template",
  "short_name": "Template",
  "description": "A focused pre-launch local-first app foundation with a blank workspace, Notes, settings, and optional GitHub Sync.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#121616",
  "theme_color": "#121616",
  "orientation": "any",
  "categories": ["utilities"],
  "icons": [
    { "src": "assets/icons/icon-192-dark.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512-dark.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512-maskable-dark.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
