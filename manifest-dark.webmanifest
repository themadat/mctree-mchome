  "orientation": "any",
  "categories": ["lifestyle", "utilities"],
  "icons": [
    { "src": "assets/icons/icon-192-dark.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512-dark.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512-maskable-dark.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
